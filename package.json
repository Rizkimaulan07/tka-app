{
  "name": "tka-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:all": "concurrently -k -n WEB,API -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "dev:open": "concurrently -k -n WEB,API -c cyan,magenta \"vite --open\" \"npm:dev:api\"",
    "db:start": "tsx --tsconfig tsconfig.server.json server/scripts/local-db.ts start",
    "db:stop": "tsx --tsconfig tsconfig.server.json server/scripts/local-db.ts stop",
    "db:status": "tsx --tsconfig tsconfig.server.json server/scripts/local-db.ts status",
    "db:reset": "tsx --tsconfig tsconfig.server.json server/scripts/local-db.ts reset",
    "db:setup": "tsx --tsconfig tsconfig.server.json server/scripts/setup.ts",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "build": "tsc -b && npm run typecheck:api && vite build",
    "start": "tsx server/index.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
