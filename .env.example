# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# Default memakai PostgreSQL lokal yang dibuat oleh `npm run db:start`.
DATABASE_URL=postgres://postgres@127.0.0.1:55432/siap_tka
PORT=3001
# Set true bila database memakai SSL (misalnya layanan cloud).
DATABASE_SSL=false
# Opsional: folder bin PostgreSQL bila tidak terdeteksi otomatis.
# PG_BIN=C:\Program Files\PostgreSQL\17\bin
